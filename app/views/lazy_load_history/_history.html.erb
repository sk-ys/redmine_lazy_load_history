<%# select top n journal entries %>
<% initial_journal_count = User.current.pref[:initial_load_count]&.to_i || Setting.plugin_redmine_lazy_load_history['initial_load_count'].to_i || 0 %>
<% load_journal_count = User.current.pref[:load_count]&.to_i || Setting.plugin_redmine_lazy_load_history['load_count'].to_i || 0 %>
<% issue = tab[:locals][:issue] %>
<% journals = tab[:locals][:journals] || [] %>
<% visible_journals = journals %>
<% if User.current.wants_comments_in_reverse_order? %>
<%   visible_journals = journals.first(initial_journal_count) if initial_journal_count > 0 %>
<%   cursor_journal = visible_journals.last %>
<% else %>
<%   visible_journals = journals.last(initial_journal_count) if initial_journal_count > 0 %>
<%   cursor_journal = visible_journals.first %>
<% end %>
<% has_more = visible_journals.size < journals.size %>

<% limited_tab = tab.dup %>
<% limited_tab[:locals] = tab[:locals].dup %>
<% limited_tab[:locals][:journals] = visible_journals %>

<%= render partial: 'issues/tabs/history', locals: {tab: limited_tab} %>

<div id="lazy-load-history"
		 data-controller="lazy-load-history"
		 data-lazy-load-history-url-value="<%= lazy_load_history_issue_journals_path(issue_id: issue.id) %>"
		 data-lazy-load-history-cursor-id-value="<%= cursor_journal&.id || 0 %>"
		 data-lazy-load-history-total-size-value="<%= journals.size %>"
		 data-lazy-load-history-loaded-size-value="<%= visible_journals.size %>"
		 data-lazy-load-history-remaining-size-value="<%= journals.size - visible_journals.size %>">
	<div class="lazy-load-history-footer">
		<div class="lazy-load-history-divider">
			<hr>
			<div class="lazy-load-history-button-base">
				<button type="button"
								title="<%= t('lazy_load_history.title_button_show_more') %>"
								data-lazy-load-history-target="button"
								data-action="lazy-load-history#loadMore"
								<%= has_more ? '' : 'hidden' %>>
					<%= t('lazy_load_history.button_show_more') %>
					(<span class="lazy-load-history-remaining-count" data-lazy-load-history-target="remainingCount" aria-hidden="true">
						<%= t('lazy_load_history.remaining_items_count', count: journals.size - visible_journals.size) %>
					</span>)
				</button>
			</div>
			<hr>
		</div>
		<span class="lazy-load-history-status" data-lazy-load-history-target="status" aria-live="polite"></span>
	</div>
</div>

<% content_for :header_tags do %>
	<script>
		window.lazyLoadHistory = {
			i18n: {
				loading: "<%= j(t('lazy_load_history.loading')) %>",
				error: "<%= j(t('lazy_load_history.error')) %>",
				remainingItemsCount: "<%= j(t('lazy_load_history.remaining_items_count', count: '%{count}')) %>"
			},
			config: {
				initialLoadCount: <%= initial_journal_count %>,
				loadJournalCount: <%= load_journal_count %>,
				sortOrder: "<%= User.current.wants_comments_in_reverse_order? ? 'desc' : 'asc' %>"
			}
		};
	</script>
  <%= stylesheet_link_tag 'lazy_load_history', plugin: 'redmine_lazy_load_history' %>
  <%= javascript_include_tag 'lazy_load_history', plugin: 'redmine_lazy_load_history' %>
<% end %>
